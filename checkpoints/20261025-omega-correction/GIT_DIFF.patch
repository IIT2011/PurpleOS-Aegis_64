+         [rsp+16]: User RFLAGS (0x202 = IF enabled)
+         [rsp+24]: User RSP
+         [rsp+32]: User SS  (0x1B: RPL 3)
+    */
+    xorq %rax, %rax
+    movw %ax, %ds
+    movw %ax, %es
+    xorq %rax, %rax
+    xorq %rbx, %rbx
+    xorq %rcx, %rcx
+    xorq %rdx, %rdx
+    xorq %rsi, %rsi
+    xorq %rdi, %rdi
+    xorq %rbp, %rbp
+    xorq %r8, %r8
+    xorq %r9, %r9
+    xorq %r10, %r10
+    xorq %r11, %r11
+    xorq %r12, %r12
+    xorq %r13, %r13
+    xorq %r14, %r14
+    xorq %r15, %r15
