#!/usr/bin/env python3
import sys
import os
import struct
import zlib

def crc32_gpt(data: bytes) -> int:
    return zlib.crc32(data) & 0xFFFFFFFF

def format_purplefs_v2(total_blocks, label, files):
    data = bytearray(total_blocks * 4096)

    # 1. Superblock at block 0
    sb = bytearray(4096)
    sig = b"PURPLEFS\x00PFS2\x00\x00\x00"
    sb[0:16] = sig

    journal_start = total_blocks - 8
    struct.pack_into("<IIIIIIIIIIII", sb, 16,
        2,              # version = 2
        4096,           # block_size = 4096
        total_blocks,   # total_blocks
        total_blocks,   # free_blocks placeholder
        256,            # total_inodes
        256,            # free_inodes placeholder
        1,              # bitmap_start_block
        1,              # bitmap_block_count
        2,              # inode_start_block
        8,              # inode_block_count
        10,             # data_start_block
        journal_start   # journal_start_block
    )
    struct.pack_into("<II", sb, 16 + 48, 8, 1) # journal_block_count=8, feature_flags=1
    struct.pack_into("<QQII", sb, 16 + 56, 0, 0, 0, 1) # clean_unmount=1
    sb[0x60:0x70] = b"\x11\x22\x33\x44" * 4
    lbl_b = label.encode("ascii")[:15]
    sb[0x70:0x70+len(lbl_b)] = lbl_b

    # Allocation bitmap
    bitmap = bytearray(4096)
    def set_bit(b):
        bitmap[b // 8] |= (1 << (b % 8))

    for b in range(11): set_bit(b)
    for b in range(journal_start, total_blocks): set_bit(b)
    for b in range(total_blocks, 32768): set_bit(b)

    # Inode table (8 blocks = 32 KiB, 256 inodes of 128 bytes)
    inodes = bytearray(8 * 4096)

    # Root dir dirents block (block 10)
    names = [name.encode("ascii") for name in files]
    if any(len(name) > 55 for name in names) or 64 + sum(64 if len(name) > 23 else 32 for name in names) > 4096:
        raise ValueError("System files exceed the PurpleFS v2 root directory limits")
    dir_block = bytearray(4096)
    def pack_dirent(offset, ino, name, ftype):
        name_b = name.encode("ascii")
        rec_len = 64 if len(name_b) > 23 else 32
        struct.pack_into("<IHBB", dir_block, offset, ino, rec_len, len(name_b), ftype)
        dir_block[offset+8:offset+8+len(name_b)] = name_b
        return rec_len

    pack_dirent(0, 1, ".", 2)
    pack_dirent(32, 1, "..", 2)
    dirent_offset = 64

    allocated_blocks = 11
    allocated_inodes = 1 + len(files)
    cur_data_block = 11
    file_ino = 2
    pointers_per_block = 4096 // 4

    def allocate_pointer_block(pointers):
        nonlocal cur_data_block, allocated_blocks
        block = cur_data_block
        cur_data_block += 1
        allocated_blocks += 1
        set_bit(block)
        for index, value in enumerate(pointers):
            struct.pack_into("<I", data, block * 4096 + index * 4, value)
        return block

    for fname, fcontent in files.items():
        if isinstance(fcontent, str):
            fcontent = fcontent.encode("utf-8")
        fsize = len(fcontent)
        nblocks = (fsize + 4095) // 4096 if fsize > 0 else 0
        double_blocks = max(0, nblocks - 12 - pointers_per_block)
        leaf_blocks = (double_blocks + pointers_per_block - 1) // pointers_per_block
        pointer_blocks = int(nblocks > 12) + leaf_blocks + int(double_blocks > 0)
        if (nblocks > 12 + pointers_per_block + pointers_per_block**2
                or cur_data_block + nblocks + pointer_blocks > journal_start):
            raise ValueError(f"File exceeds available PurpleFS capacity: {fname}")
        file_blocks = []
        for _ in range(nblocks):
            file_blocks.append(cur_data_block)
            set_bit(cur_data_block)
            cur_data_block += 1
            allocated_blocks += 1

        for i, blk in enumerate(file_blocks):
            chunk = fcontent[i*4096 : (i+1)*4096]
            data[blk*4096 : blk*4096 + len(chunk)] = chunk

        ino_offset = file_ino * 128
        struct.pack_into("<HHHHQQQ", inodes, ino_offset,
            0x81A4, # S_IFREG | 0644
            0, 0, 1, # uid, gid, links_count
            fsize, 0, 0 # size, atime, mtime
        )
        for i, blk in enumerate(file_blocks[:12]):
            struct.pack_into("<I", inodes, ino_offset + 0x2C + i*4, blk)
        if len(file_blocks) > 12:
            single_end = 12 + pointers_per_block
            indirect_blk = allocate_pointer_block(file_blocks[12:single_end])
            struct.pack_into("<I", inodes, ino_offset + 0x5C, indirect_blk)
            if double_blocks:
                leaves = [
                    allocate_pointer_block(file_blocks[start:start + pointers_per_block])
                    for start in range(single_end, len(file_blocks), pointers_per_block)
                ]
                root = allocate_pointer_block(leaves)
                struct.pack_into("<I", inodes, ino_offset + 0x60, root)

        icrc = zlib.crc32(inodes[ino_offset : ino_offset + 0x7C]) & 0xFFFFFFFF
        struct.pack_into("<I", inodes, ino_offset + 0x7C, icrc)

        rec_len = pack_dirent(dirent_offset, file_ino, fname, 1)
        dirent_offset += rec_len
        file_ino += 1

    # Root dir inode (Inode 1)
    struct.pack_into("<HHHHQQQ", inodes, 128,
        0x41ED, # S_IFDIR | 0755
        0, 0, 2, # links
        4096, 0, 0
    )
    struct.pack_into("<I", inodes, 128 + 0x2C, 10)
    root_icrc = zlib.crc32(inodes[128 : 128 + 0x7C]) & 0xFFFFFFFF
    struct.pack_into("<I", inodes, 128 + 0x7C, root_icrc)

    # Free blocks/inodes in superblock
    struct.pack_into("<I", sb, 28, total_blocks - allocated_blocks - 8)
    struct.pack_into("<I", sb, 36, 256 - allocated_inodes)
    sbcrc = zlib.crc32(sb[:0x80]) & 0xFFFFFFFF
    struct.pack_into("<I", sb, 0x80, sbcrc)

    # Journal header
    jhdr = bytearray(4096)
    struct.pack_into("<IIQI", jhdr, 0, 0x5046534A, 0, 1, 0)
    jcrc = zlib.crc32(jhdr[:4+4+8+4+24+24]) & 0xFFFFFFFF
    struct.pack_into("<I", jhdr, 4+4+8+4+24+24, jcrc)

    data[0:4096] = sb
    data[4096:8192] = bitmap
    data[2*4096 : 10*4096] = inodes
    data[10*4096 : 11*4096] = dir_block
    data[journal_start*4096 : (journal_start+1)*4096] = jhdr

    return data

def build_gpt_disk(disk_path, total_disk_sectors=2097152, signing_key=None, applications_dir=None,
                   https_roots=None, account_profile=None): # 1024 MiB
    os.makedirs(os.path.dirname(os.path.abspath(disk_path)), exist_ok=True)
    
    # Files to seed into PurpleFS
    e1000_path = "build/drivers_apdrv/e1000.apdrv"
    if not os.path.exists(e1000_path):
        e1000_path = "build/e1000.apdrv"
    e1000_data = open(e1000_path, "rb").read() if os.path.exists(e1000_path) else b"APDRV100"

    cmd_dtbase_path = "build/cmd.dtbase"
    if not os.path.exists(cmd_dtbase_path):
        cmd_dtbase_path = os.path.join(os.path.dirname(__file__), "cmd.dtbase")
    if not os.path.exists(cmd_dtbase_path):
        import subprocess
        script_path = os.path.join(os.path.dirname(__file__), "../scripts/generate_cmd_dtbase.py")
        subprocess.check_call([sys.executable, script_path, cmd_dtbase_path])
    cmd_dtbase_data = open(cmd_dtbase_path, "rb").read() if os.path.exists(cmd_dtbase_path) else b""

    path_dtbase_path = "build/path.dtbase"
    if not os.path.exists(path_dtbase_path):
        path_dtbase_path = os.path.join(os.path.dirname(__file__), "path.dtbase")
    if not os.path.exists(path_dtbase_path):
        import subprocess
        script_path = os.path.join(os.path.dirname(__file__), "../scripts/generate_path_dtbase.py")
        subprocess.check_call([sys.executable, script_path, path_dtbase_path])
    path_dtbase_data = open(path_dtbase_path, "rb").read() if os.path.exists(path_dtbase_path) else b""

    desktop_cfg = b"""[Display]
resolution = 800x600
bpp = 32
refresh_rate = 60
double_buffer = true
vsync = true

[Theme]
name = PurpleNebula
wallpaper_gradient_top = 0x120722
wallpaper_gradient_bot = 0x280E46
accent_color = 0x7E3FF2
window_title_active_top = 0x5D289D
window_title_active_bot = 0x351259
window_title_inactive_top = 0x332E3F
window_title_inactive_bot = 0x1D1926
font = Aegis8x16

[Cursor]
theme = DefaultAegisArrow
size = 16
pointer_color = 0xFFFFFFFF
border_color = 0xFF000000

[Compositor]
service = /System/Services/Compositor
framework = /System/Frameworks/Compositor.framework
device = /dev/compositor
fb_device = /dev/fb0
max_windows = 16
shadows = true
"""

    compositor_service = b"""[Service]
Name = PurpleCompositor
Description = Aegis64 Native Window Server and Framebuffer Compositor
Type = KernelSubsystem
DeviceNode = /dev/compositor
Framebuffer = /dev/fb0
Status = Active
Priority = RealTime
Target = Desktop
"""

    compositor_fw_conf = b"""[Framework]
Name = Compositor.framework
Version = 1.0.0
Description = Aegis64 Native Windowing and Surface Client Library
Target = x86_64-unknown-none
Protocol = AegisIPC-Compositor-v1
Header = Compositor.h
Library = libcompositor.a
"""

    files = {
        "welcome.txt": b"Welcome to Purple OS / Aegis64 Native Filesystem!\n",
        "version.txt": b"Aegis64 Kernel v0.4.0 (Stage 4B Safe Kernel Storage Integration)\n",
        "motd": b"Message of the Day: Aegis64 Pure Rust Operational.\n",
        "System/CLI/cmd.dtbase": cmd_dtbase_data,
        "System/CLI/path.dtbase": path_dtbase_data,
        "System/Configuration/desktop.cfg": desktop_cfg,
        "System/Services/Compositor": compositor_service,
        "System/Frameworks/Compositor.framework/compositor.conf": compositor_fw_conf,
    }

    # Seed unified category modules and filesystem drivers
    for mod_name in [
        "cpu.apdrv", "ram.apdrv", "gpu.apdrv", "storage.apdrv", "network.apdrv",
        "audio.apdrv", "usb.apdrv", "input.apdrv", "filesystems.apdrv",
        "purplefs.apdrv", "fat32.apdrv", "ext4.apdrv", "iso9660.apdrv", "ramfs.apdrv"
    ]:
        mod_path = os.path.join("build/drivers_apdrv", mod_name)
        if not os.path.exists(mod_path):
            mod_path = os.path.join("build", mod_name)
        if os.path.exists(mod_path):
            files[f"System/Drivers/{mod_name}"] = open(mod_path, "rb").read()

    if e1000_data:
        files["System/Drivers/e1000.apdrv"] = e1000_data

    # Seed System Fonts from assets/fonts/Inter
    font_files = [
        "Inter-Regular.ttf",
        "Inter-Bold.ttf",
        "Inter-Medium.ttf",
        "Inter-SemiBold.ttf",
        "Inter-Italic.ttf",
        "Inter-Light.ttf",
        "Inter.conf",
        "LICENSE.txt",
    ]
    for font_f in font_files:
        fpath = os.path.join("assets/fonts/Inter", font_f)
        if not os.path.exists(fpath):
            fpath = os.path.join("../Inter-4.1/extras/ttf", font_f)
        if not os.path.exists(fpath):
            fpath = os.path.join("../Inter-4.1", font_f)
        if os.path.exists(fpath):
            files[f"System/Resources/Fonts/{font_f}"] = open(fpath, "rb").read()

    # Inject system vector icons into /System/Resources/Icons/
    icon_dir = "assets/icons"
    if os.path.exists(icon_dir):
        for icon_f in sorted(os.listdir(icon_dir)):
            if icon_f.endswith(".svg"):
                ipath = os.path.join(icon_dir, icon_f)
                files[f"System/Resources/Icons/{icon_f}"] = open(ipath, "rb").read()

    if applications_dir:
        from pathlib import Path
        application_sources = Path(applications_dir)
        for name in ("trust.policy", "trust.policy.sig"):
            files[f"System/Applications/{name}"] = (application_sources / name).read_bytes()
        for bundle in sorted(application_sources.glob("*.apapplication")):
            files[f"System/Applications/{bundle.name}"] = bundle.read_bytes()

    if https_roots:
        from pathlib import Path

        bundle = Path(https_roots)
        system_path = "System/Network/https-roots.pem"
        files[system_path] = bundle.read_bytes()
        files[system_path + ".sig"] = bundle.with_name(bundle.name + ".sig").read_bytes()

    if account_profile and not signing_key:
        raise ValueError("An account profile requires a Creator signing key")

    if signing_key:
        import hashlib
        from pathlib import Path

        sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
        from sign_cmddb import sign_payload_rsa

        if account_profile:
            payload = Path(account_profile).read_bytes()
            if not 0 < len(payload) < 128:
                raise ValueError("Account profile must be 1 to 127 bytes")
            account_path = "System/Configuration/account.conf"
            files[account_path] = payload
            signature = sign_payload_rsa(b"PurpleOS/LOCAL-ACCOUNT/v1\0" + payload, signing_key)
            files[account_path + ".sig"] = signature.encode("ascii")

        manifest_path = "System/components.manifest"
        manifest = b"".join(
            f"{hashlib.sha256(data).hexdigest()}  {name}\n".encode("ascii")
            for name, data in sorted(files.items()) if name != "System/CLI/path.dtbase"
        )
        signature = sign_payload_rsa(b"PurpleOS/COMPONENTS/v1\0" + manifest, signing_key)
        files[manifest_path] = manifest
        files[manifest_path + ".sig"] = signature.encode("ascii")

    pfs_data = format_purplefs_v2(32768, "PurpleSystem", files)
    pfs_sectors = len(pfs_data) // 512

    p1_start = 2048
    p1_end = p1_start + pfs_sectors - 1

    if p1_end > total_disk_sectors - 34:
        raise ValueError("Disk is too small for PurpleFS and backup GPT")

    # Protective MBR at LBA 0
    mbr = bytearray(512)
    mbr[446 + 4] = 0xEE
    struct.pack_into("<I", mbr, 446 + 8, 1)
    struct.pack_into("<I", mbr, 446 + 12, total_disk_sectors - 1)
    mbr[510:512] = b"\x55\xAA"

    # Generate Partition Entries
    entries = bytearray(128 * 128)
    pfs_guid = bytes([
        0x50, 0x55, 0x52, 0x50,
        0x4C, 0x45,
        0x2D, 0x4F,
        0x53, 0x2D,
        0x46, 0x53, 0x2D, 0x56, 0x32, 0x30
    ])
    entries[0:16] = pfs_guid
    entries[16:32] = os.urandom(16)
    struct.pack_into("<QQQ", entries, 32, p1_start, p1_end, 0)
    name1 = "PurpleRootFS".encode("utf-16le")
    entries[56:56 + len(name1)] = name1

    entries_crc = crc32_gpt(entries)

    # GPT Header at LBA 1
    gpt_hdr = bytearray(512)
    gpt_hdr[0:8] = b"EFI PART"
    struct.pack_into("<II", gpt_hdr, 8, 0x00010000, 92)
    struct.pack_into("<Q", gpt_hdr, 24, 1)
    struct.pack_into("<Q", gpt_hdr, 32, total_disk_sectors - 1)
    struct.pack_into("<Q", gpt_hdr, 40, 34)
    struct.pack_into("<Q", gpt_hdr, 48, total_disk_sectors - 34)
    gpt_hdr[56:72] = os.urandom(16)
    struct.pack_into("<QII", gpt_hdr, 72, 2, 128, 128)
    struct.pack_into("<I", gpt_hdr, 88, entries_crc)
    hdr_crc = crc32_gpt(gpt_hdr[:92])
    struct.pack_into("<I", gpt_hdr, 16, hdr_crc)

    # Backup GPT
    backup_hdr = bytearray(gpt_hdr)
    struct.pack_into("<Q", backup_hdr, 24, total_disk_sectors - 1)
    struct.pack_into("<Q", backup_hdr, 32, 1)
    struct.pack_into("<Q", backup_hdr, 72, total_disk_sectors - 33)
    struct.pack_into("<I", backup_hdr, 16, 0)
    backup_crc = crc32_gpt(backup_hdr[:92])
    struct.pack_into("<I", backup_hdr, 16, backup_crc)

    backup_entries_lba = total_disk_sectors - 33

    with open(disk_path, "wb") as f:
        f.truncate(total_disk_sectors * 512)
        f.write(mbr)
        f.write(gpt_hdr)
        f.write(entries)
        f.seek(p1_start * 512)
        f.write(pfs_data)
        f.seek(backup_entries_lba * 512)
        f.write(entries)
        f.write(backup_hdr)
    print(f"[OK] Formatted GPT disk with PurpleFS v2 at {disk_path}")

if __name__ == "__main__":
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument("output_image")
    parser.add_argument("--signing-key")
    parser.add_argument("--applications-dir", help="stage an existing signed application policy and bundles")
    parser.add_argument("--https-roots", help="stage an approved CA bundle and its AegisDetect .sig sidecar")
    parser.add_argument("--account-profile", help="configure and sign a local account profile")
    args = parser.parse_args()
    build_gpt_disk(args.output_image, signing_key=args.signing_key, applications_dir=args.applications_dir,
                   https_roots=args.https_roots, account_profile=args.account_profile)
